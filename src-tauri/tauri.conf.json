{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "猫步互联 Pro",
  "version": "2.3.5",
  "identifier": "com.landisk.desktop",
  "build": {
    "frontendDist": "../desktop-dist",
    "beforeDevCommand": "node scripts/prepare-tauri.js",
    "beforeBuildCommand": "node scripts/prepare-tauri.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "猫步互联 Pro",
        "width": 1020,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "externalBin": [
      "binaries/lan-disk-server"
    ],
    "resources": [
      "../public/**/*",
      "../shared/**/*",
      "binaries/7za.exe",
      "binaries/system-control.ps1"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
