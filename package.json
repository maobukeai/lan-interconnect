{
  "name": "lan-disk",
  "version": "2.2.0",
  "description": "猫步互联 - 局域网文件共享与跨设备通信工具",
  "author": "Developer",
  "scripts": {
    "start": "tauri dev",
    "server": "node server.js",
    "test": "node test.js && node test-remote.js && node test-text-renderer.js && node test-study.js",
    "test:all": "node test.js && node test-remote.js && node test-text-renderer.js && node test-study.js && node scripts/smoke-realtime.js",
    "build": "npm run build:tauri",
    "build:desktop": "node scripts/build-desktop-web.js",
    "build:sidecar": "node scripts/build-sidecar.js",
    "build:mobile": "node scripts/build-mobile-web.js",
    "build:tauri": "tauri build",
    "tauri:dev": "tauri dev",
    "build:android": "node scripts/build-mobile-web.js && npx cap sync android && node scripts/patch-android-java17.js && cd android && gradlew.bat assembleDebug",
    "build:artifacts": "node scripts/prepare-windows-artifacts.js",
    "version:set": "node scripts/bump-version.js",
    "clean": "rimraf desktop-dist dist-server dist_output"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "^0.28.2",
    "rimraf": "^5.0.0",
    "sharp": "^0.35.4"
  }
}
