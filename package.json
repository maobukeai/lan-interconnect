{
  "name": "lan-disk",
  "version": "1.5.0",
  "description": "猫步互联 - 局域网文件共享与跨设备通信工具",
  "author": "Developer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build": "electron-builder --win --x64",
    "rebuild": "electron-rebuild -f -w",
    "clean": "rimraf dist release"
  },
  "build": {
    "appId": "com.landisk.app",
    "productName": "猫步互联 Pro",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/archiver/**/*",
      "node_modules/archiver-utils/**/*",
      "node_modules/zip-stream/**/*",
      "public/**/*",
      "shared/**/*",
      "server/services/**/*"
    ],
    "files": [
      "**/*",
      "!node_modules/7zip-bin/win/ia32/**",
      "!node_modules/7zip-bin/win/arm64/**",
      "!node_modules/7zip-bin/mac/**",
      "!node_modules/7zip-bin/linux/**",
      "!dist/**",
      "!release/**",
      "!.git/**",
      "!.lingma/**",
      "!*.log"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "electron": "^41.0.3",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "rimraf": "^5.0.0",
    "sharp": "^0.35.4"
  }
}
